---
// 画廊组件：有序瀑布流
//
// 思路：
//  1. 服务端按 photos.json 顺序渲染成平铺列表（DOM 顺序 = 照片顺序，
//     灯箱的翻页顺序自然正确，无需额外处理）
//  2. 浏览器端用少量 JS 按视口宽度把元素分进 N 列容器，分配策略是
//     「当前最短列优先」，于是视觉上从左到右、从上到下就是数组顺序
//  3. 无 JS 时退化为单列平铺，顺序依然正确
//
// 样式与分栏脚本都在 global.css / Base.astro（全局），不放组件里：
// 站内是局部换页（不刷新页面），组件级样式和脚本在换页后不一定生效
import { assetUrl, assetSrcset } from '../lib/asset-url';

interface Photo {
  id: string;
  src: string;
  srcset?: string;
  width: number;
  height: number;
  title?: string;
  // 拍摄地（如 "四川 成都"），灯箱里显示
  location?: string;
  // taken 是拍摄日期（"2026-09-20"），画廊里取前四位当「拍摄年份」用于筛选
  exif?: {
    camera?: string;
    focal?: string;
    aperture?: string;
    shutter?: string;
    iso?: string;
    taken?: string;
  } | null;
  // 色调标签（1–2 个，如 ["橙", "蓝"]），由 scripts/color-tags.mjs 生成，
  // 供单幅作品页按色调筛选。为空表示还没打过标，那张照片不参与色调筛选。
  colors?: string[] | null;
}
interface Props {
  photos: Photo[];
  // 系列名，灯箱左上角序号后面显示；不传（如全部照片页）则显示「全部照片」
  seriesName?: string;
  // 整页最靠前的 N 张用 eager + fetchpriority=high 提前加载（首屏 LCP 图片），
  // 其余保持 lazy。只对页面第一个分组传 1~2，避免全站 eager 互相抢带宽。
  eager?: number;
}
const { photos, seriesName = '全部照片', eager = 0 } = Astro.props;
---

<div class="gallery" data-gallery>
  {photos.map((p, i) => (
    <a
      href={assetUrl(p.src)}
      data-lightbox
      data-title={p.title ?? ''}
      data-series={seriesName}
      data-location={p.location ?? ''}
      data-year={p.exif?.taken ? p.exif.taken.slice(0, 4) : ''}
      data-color={p.colors?.join(' ') || ''}
      data-srcset={assetSrcset(p.srcset)}
      data-width={p.width}
      data-height={p.height}
      data-exif={p.exif ? JSON.stringify(p.exif) : undefined}
      class="g-item"
    >
      <img
        src={assetUrl(p.src)}
        srcset={assetSrcset(p.srcset)}
        sizes="(max-width: 767px) 50vw, (max-width: 999px) 34vw, 259px"
        width={p.width}
        height={p.height}
        alt={p.title ?? '摄影作品'}
        loading={i < eager ? 'eager' : 'lazy'}
        fetchpriority={i < eager ? 'high' : undefined}
        decoding="async"
      />
    </a>
  ))}
</div>
