---
// 首页：大图 hero
// 背景图从所有照片里随机抽一张（抽取逻辑在 Base.astro 的 applyRandomHero）
import Base from '../layouts/Base.astro';
import { assetUrl, assetSrcset } from '../lib/asset-url';
import allPhotos from '../data/photos.json';

// 首页背景的候选池：每次打开随机抽一张（抽取逻辑在 Base.astro 的 applyRandomHero）。
// 只用横构图——竖图铺满整屏会被裁掉大半；横图不够时再退回全部照片。
const landscape = allPhotos.filter((p) => p.width >= p.height);
const heroPool = (landscape.length ? landscape : allPhotos).map((p) => ({
  src: assetUrl(p.src),
  srcset: assetSrcset(p.srcset),
}));
---

<Base title="David Photography · 摄影作品集" description="个人摄影作品集：风光、纪实、旅行摄影系列">
  <section class="hero">
    <!-- 背景图不写死 src，由脚本从下面这个池子里随机挑一张再写上 -->
    <img data-hero-random alt="" fetchpriority="high" decoding="async" />
    <template data-hero-pool set:html={JSON.stringify(heroPool)}></template>
    <div class="hero-text">
      <!-- 字标用图片而不是 <h1> 文字：public/brand/slogan.webp。
           写死 width/height，图没下载完也不会先把副标题顶下去 -->
      <img class="hero-wordmark" src="/brand/slogan.webp" width="1361" height="216" alt="用影像和时间做朋友" />
      <p>David Photography · 摄影作品集</p>
      <div class="hero-actions">
        <a class="hero-btn" href="/single/">单幅作品</a>
        <a class="hero-btn hero-btn-ghost" href="/series/">系列作品</a>
      </div>
    </div>
  </section>
</Base>
