---
// 系列作品页：从 src/data/series.json 自动生成系列卡片。
// 还没有照片、但想先占个位的系列，在 series.json 里标 "pending": true
// （例如「商业拍摄」——内容以后再补）。
import Base from '../layouts/Base.astro';
import allSeries from '../data/series.json';
import allPhotos from '../data/photos.json';
import { assetUrl } from '../lib/asset-url';

const countOf = (slug) => allPhotos.filter((p) => p.series === slug).length;

const series = allSeries
  .filter((s) => countOf(s.slug) > 0 || s.pending)
  .map((s) => {
    const n = countOf(s.slug);
    return { ...s, n, span: seriesSpan(s.slug), empty: n === 0 };
  });

// 时间涵盖范围：该系列全部照片拍摄日期的最早~最晚年份，跨年显示「2023–2026」。
function seriesSpan(slug) {
  const years = allPhotos
    .filter((p) => p.series === slug)
    .map((p) => p.exif?.taken)
    .filter(Boolean)
    .map((d) => d.slice(0, 4))
    .sort();
  if (years.length === 0) return '';
  const first = years[0];
  const last = years[years.length - 1];
  return first === last ? first : `${first}–${last}`;
}
---

<Base title="系列作品 · 摄影作品集" description="系列摄影作品">
  <div class="container page-container">
    <h1 class="section-title">系列作品</h1>
    {series.length === 0 ? (
      <p class="page-empty">系列作品整理中，稍后更新。</p>
    ) : (
      <div class="series-grid">
        {series.map((s) => (
          <a class={`series-card${s.empty ? ' series-card-empty' : ''}`} href={`/series/${s.slug}/`}>
            {s.empty ? null : (
              <img src={assetUrl(s.cover)} alt={s.title} loading="lazy" decoding="async" />
            )}
            <div class="card-text">
              <h3>{s.title}</h3>
              <p>{s.empty ? '内容整理中' : s.span}</p>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</Base>
