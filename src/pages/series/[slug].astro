---
// 系列详情页：根据 series.json 里的每个 slug 自动生成一个页面（/series/mountains/ 等）
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import allSeries from '../../data/series.json';
import allPhotos from '../../data/photos.json';

export function getStaticPaths() {
  return allSeries.map((s) => ({
    params: { slug: s.slug },
    props: { s },
  }));
}

const { s } = Astro.props;
const photos = allPhotos.filter((p) => p.series === s.slug);
---

<Base title={`${s.title} · 摄影作品集`} description={s.subtitle}>
  <!-- 整屏封面：小标题 / 超大主标题 / 年份·张数 / 向下滚动提示 -->
  <section class="series-hero">
    <img src={s.cover} alt={s.title} />
    <div class="series-hero-veil"></div>
    <div class="series-hero-inner">
      <p class="hero-kicker"><span class="hero-dash"></span>{s.subtitle}</p>
      <h1>{s.title}</h1>
      <p class="hero-meta">{s.year} · 共 {photos.length} 张作品</p>
    </div>
    <div class="hero-scroll">向下滚动探索<span class="chev">⌄</span></div>
  </section>

  <div class="container">
    <p class="series-desc">{s.description}</p>
    <Gallery photos={photos} seriesName={s.title} />
  </div>
</Base>
