---
// 系列详情页：根据 series.json 里的每个 slug 自动生成一个页面（/series/mountains/ 等）
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import allSeries from '../../data/series.json';
import allPhotos from '../../data/photos.json';
import { assetUrl } from '../../lib/asset-url';

export function getStaticPaths() {
  return allSeries.map((s) => ({
    params: { slug: s.slug },
    props: { s },
  }));
}

const { s } = Astro.props;
const photos = allPhotos.filter((p) => p.series === s.slug);
const isEmpty = photos.length === 0;

// 系列阐述：首字单独包一层，做首字下沉（只放大这个字，不含后面的标点）
const descText = (s.description ?? '').trim();
const descCap = descText.slice(0, 1);
const descRest = descText.slice(1);

// 时间涵盖范围：全部照片拍摄日期的最早~最晚年份，跨年显示「2023–2026」。
const spanYears = photos
  .map((p) => p.exif?.taken)
  .filter(Boolean)
  .map((d) => d.slice(0, 4))
  .sort();
const span =
  spanYears.length === 0 ? '' : spanYears[0] === spanYears[spanYears.length - 1]
    ? spanYears[0]
    : `${spanYears[0]}–${spanYears[spanYears.length - 1]}`;
---

<Base title={`${s.title} · 摄影作品集`} description={s.subtitle}>
  {isEmpty ? (
    <div class="container">
      <h1 class="section-title">{s.title}</h1>
      <p class="page-empty">这个系列的照片还在整理中，稍后更新。</p>
    </div>
  ) : (
  <!-- 整屏封面：小标题 / 超大主标题 / 年份·张数 / 向下滚动提示 -->
  <section class="series-hero">
    <img src={assetUrl(s.cover)} alt={s.title} />
    <div class="series-hero-veil"></div>
    <div class="series-hero-inner">
      <h1>{s.title}</h1>
      <p class="hero-meta">{span} · 共 {photos.length} 张作品</p>
    </div>
    <div class="hero-scroll">向下滚动探索<span class="chev">⌄</span></div>
  </section>

  <div class="container">
    <p class="series-desc">{descCap ? <span class="desc-cap">{descCap}</span> : null}{descRest}</p>
    <Gallery photos={photos} seriesName={s.title} />
  </div>
  )}
</Base>
