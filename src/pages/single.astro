---
// 单图作品：不属于任何系列的单张照片
// 判定规则见 src/lib/singles.ts
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import { singles } from '../lib/singles';
---

<Base title="单图作品 · 摄影作品集" description="未被系列收录的单张作品">
  <div class="container">
    <h1 class="section-title">单图作品</h1>
    {singles.length === 0 ? (
      <p class="page-empty">单图作品整理中，稍后更新。</p>
    ) : (
      <Gallery photos={singles} seriesName="单图作品" />
    )}
  </div>
</Base>
