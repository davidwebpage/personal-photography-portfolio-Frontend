{
  "name": "personal-photography-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "个人摄影作品集网站（静态站，Astro 构建）",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:local": "ASSET_MODE=local astro build",
    "build:r2": "ASSET_MODE=r2 astro build",
    "preview": "astro preview",
    "deploy:local": "npm run build:local && CF_PAGES_PROJECT=photography-portfolio-local node scripts/deploy.mjs",
    "deploy:r2": "npm run build:r2 && node scripts/deploy.mjs",
    "photos": "node scripts/build-photos.mjs",
    "from-sheet": "node scripts/build-from-sheet.mjs",
    "colors": "node scripts/color-tags.mjs",
    "changelog": "node scripts/changelog.mjs",
    "test": "node --test scripts/lib/*.test.mjs"
  },
  "dependencies": {
    "astro": "^5.13.0",
    "exceljs": "^4.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "sharp": "^0.34.3",
    "wrangler": "^4.148.0"
  }
}
